generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

enum ReservationSource {
  WEBSITE
  MANUAL
}

enum UserRole {
  ADMIN
  STAFF
}

/// How a photo occupies the public mosaic. Previously the shape came from the
/// image's position (wallLayouts[index % 8]), so inserting one photo reshuffled
/// every shape below it — the admin could not choose, only discover.
enum GalleryLayout {
  STANDARD
  WIDE
  TALL
}

enum ReminderType {
  ADMIN_UPCOMING
  GUEST_REMINDER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Reservation {
  id         String            @id @default(cuid())
  // The requested event date (stored at day granularity) and a time slot label.
  date       DateTime          @db.Date
  time       String
  eventType  String
  guestCount Int
  name       String
  phone      String
  email      String
  notes      String?
  status     ReservationStatus @default(PENDING)
  source     ReservationSource @default(WEBSITE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  reminderLogs ReminderLog[]

  @@index([date])
  @@index([status])
}

model ReminderLog {
  id            String       @id @default(cuid())
  reservationId String
  type          ReminderType
  sentAt        DateTime     @default(now())
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, type])
}

model GalleryImage {
  id        String   @id @default(cuid())
  publicId  String   @unique
  url       String
  width     Int
  height    Int
  alt       String
  caption   String?
  layout    GalleryLayout @default(STANDARD)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// One row per accepted attempt against a rate-limited action.
///
/// Deliberately Postgres-backed rather than in-memory: serverless functions do
/// not share memory, so a per-instance counter is trivially defeated by
/// concurrent requests landing on different instances.
model RateLimitHit {
  id        String   @id @default(cuid())
  /// Scope + identity, e.g. "reservation:ip:203.0.113.4" or "login:email:a@b.c".
  bucket    String
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}
